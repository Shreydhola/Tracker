DATABASE_URL=postgresql://tracker:CHANGE_ME@localhost:5432/tracker
APP_URL=http://localhost:3000
# Explicitly choose demo or live; separate databases required.
APP_MODE=demo
ADMIN_EMAIL=admin@example.com
# Used only by npm run admin:create. Set a unique 14+ character password.
ADMIN_PASSWORD=
# Set your Compose database password (must match DATABASE_URL)
POSTGRES_PASSWORD=
TRACK17_API_KEY=
# Live calls remain disabled pending verification against official docs/account.
TRACK17_CONTRACT_VERIFIED=false
TRACK17_API_VERSION=2.4
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional alternative to SMTP
RESEND_API_KEY=
