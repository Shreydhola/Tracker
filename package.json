{
  "name": "shipment-control-center",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --import tsx src/worker.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:generate": "node --import tsx scripts/generate.ts",
    "admin:create": "node --import tsx scripts/admin.ts",
    "demo:seed": "node --import tsx scripts/demo.ts",
    "test": "vitest run",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "cloud:db": "node --import tsx scripts/cloud-db.ts",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "https-proxy-agent": "7.0.6",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "pg-boss": "10.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "9.3.14",
    "tailwind-merge": "3.3.1",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.16.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
